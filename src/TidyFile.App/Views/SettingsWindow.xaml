<Window x:Class="TidyFile.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TidyFile Settings"
        Width="860"
        Height="580"
        MinWidth="700"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FF6B7280" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Margin" Value="0,12,0,4" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Red text that disappears when its Text is null. -->
    <Style x:Key="ErrorText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#FFC42B1C" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Style.Triggers>
        <Trigger Property="Text" Value="{x:Null}">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
        <Trigger Property="Text" Value="">
          <Setter Property="Visibility" Value="Collapsed" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,5" />
      <Setter Property="MinWidth" Value="80" />
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4,3" />
    </Style>
  </Window.Resources>

  <Grid Margin="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TabControl x:Name="Tabs" Grid.Row="0">

      <!-- ================= General ================= -->
      <TabItem Header="General">
        <StackPanel Margin="16" MaxWidth="560" HorizontalAlignment="Left">
          <CheckBox Content="Start TidyFile when I sign in to Windows"
                    IsChecked="{Binding StartWithWindows}" />

          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,22,0,4" Text="Popup closes after" />
          <DockPanel>
            <TextBlock DockPanel.Dock="Right"
                       Width="90"
                       Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Text="{Binding PopupSeconds, StringFormat={}{0} seconds}" />
            <Slider Minimum="5"
                    Maximum="120"
                    TickFrequency="5"
                    IsSnapToTickEnabled="True"
                    Value="{Binding PopupSeconds}" />
          </DockPanel>
          <TextBlock Style="{StaticResource Hint}" Text="The popup stays open while your mouse is over it." />

          <TextBlock Style="{StaticResource FieldLabel}" Margin="0,22,0,4" Text="Number of suggestions in the popup" />
          <ComboBox Width="80"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding MaxSuggestionChoices}"
                    SelectedItem="{Binding MaxSuggestions}" />
        </StackPanel>
      </TabItem>

      <!-- ================= Folders ================= -->
      <TabItem Header="Watched folders">
        <DockPanel Margin="16">
          <TextBlock DockPanel.Dock="Top"
                     Margin="0,0,0,10"
                     Style="{StaticResource Hint}"
                     Text="TidyFile shows a suggestion when a new file appears directly in one of these folders. Sub-folders are not watched. Changes apply as soon as you save." />

          <StackPanel DockPanel.Dock="Right" Margin="12,0,0,0">
            <Button Content="Add…" Click="AddFolder_Click" Margin="0,0,0,6" />
            <Button Content="Remove" Click="RemoveFolder_Click" />
          </StackPanel>

          <ListBox ItemsSource="{Binding Folders}"
                   SelectedItem="{Binding SelectedFolder}"
                   HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,4">
                  <TextBlock Text="{Binding Display}" FontWeight="SemiBold" />
                  <TextBlock x:Name="StatusText"
                             Text="{Binding Status}"
                             FontSize="11"
                             Foreground="#FF6B7280"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Exists}" Value="False">
                    <Setter TargetName="StatusText" Property="Foreground" Value="#FFC42B1C" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <!-- ================= Rules ================= -->
      <TabItem x:Name="RulesTab" Header="Rules">
        <Grid Margin="12">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MinWidth="260" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="6*" MinWidth="300" />
          </Grid.ColumnDefinitions>

          <!-- Shown when rules.json could not be read and the defaults are being edited instead. -->
          <Border Grid.Row="0"
                  Grid.ColumnSpan="3"
                  Margin="0,0,0,10"
                  Padding="10,6"
                  Background="#FFFDECEA"
                  BorderBrush="#FFC42B1C"
                  BorderThickness="1"
                  CornerRadius="3">
            <Border.Style>
              <Style TargetType="Border">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding RulesWarning}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding RulesWarning}" Foreground="#FFC42B1C" TextWrapping="Wrap" />
          </Border>

          <!-- Rule list -->
          <DockPanel Grid.Row="1" Grid.Column="0">
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,8"
                       Style="{StaticResource Hint}"
                       Text="Rules that match both the file type and the name rank highest. On a tie, the rule higher in the list wins." />

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
              <Button Content="Add" Click="AddRule_Click" MinWidth="60" />
              <Button Content="Delete" Click="DeleteRule_Click" MinWidth="60" Margin="6,0,0,0" />
              <Button Content="▲" Click="MoveRuleUp_Click" MinWidth="36" Padding="8,5" Margin="12,0,0,0" ToolTip="Move up" />
              <Button Content="▼" Click="MoveRuleDown_Click" MinWidth="36" Padding="8,5" Margin="4,0,0,0" ToolTip="Move down" />
            </StackPanel>

            <ListBox x:Name="RulesList"
                     ItemsSource="{Binding Rules}"
                     SelectedItem="{Binding SelectedRule}"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <DockPanel Margin="0,3">
                    <CheckBox DockPanel.Dock="Left"
                              VerticalAlignment="Top"
                              Margin="0,2,8,0"
                              IsChecked="{Binding Enabled}"
                              ToolTip="Enabled" />
                    <TextBlock DockPanel.Dock="Right"
                               Text="⚠"
                               Foreground="#FFC42B1C"
                               Margin="6,0,0,0"
                               ToolTip="{Binding Problem}"
                               Visibility="{Binding HasProblem, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel>
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#FF6B7280" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </DockPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>

          <!-- Rule editor + tester -->
          <ScrollViewer Grid.Row="1" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <StackPanel DataContext="{Binding SelectedRule}"
                          IsEnabled="{Binding DataContext.HasSelectedRule, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Name" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="File types" />
                <TextBox Text="{Binding ExtensionsText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}" Text="Extensions separated by commas, e.g. pdf, docx. Leave empty to match any type." />

                <TextBlock Style="{StaticResource FieldLabel}" Text="File name contains (optional)" />
                <TextBox Text="{Binding NamePattern, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" />
                <TextBlock Style="{StaticResource Hint}" Text="A regular expression, not case-sensitive. Use | for &quot;or&quot;, e.g. invoice|receipt. ^ means &quot;starts with&quot;." />
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding PatternError}" />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Downloaded from (optional)" />
                <TextBox Text="{Binding SourcesText, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Style="{StaticResource Hint}" Text="Websites separated by commas, e.g. github.com. Sub-sites match too. Files whose website isn't known won't match." />

                <TextBlock Style="{StaticResource FieldLabel}" Text="Move to" />
                <DockPanel>
                  <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseDestination_Click" Margin="6,0,0,0" />
                  <TextBox Text="{Binding Destination, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
                <TextBlock Style="{StaticResource Hint}" Text="You can use {Documents}, {Downloads}, {Desktop}, {Pictures}, {Music}, {Videos} or {Home}." />

                <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" Margin="0,12,0,0" />
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Problem}" />
              </StackPanel>

              <Separator Margin="0,16,0,8" />

              <TextBlock Style="{StaticResource FieldLabel}" Margin="0,0,0,4" Text="Test a file name" />
              <TextBox Text="{Binding TestFileName, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Style="{StaticResource Hint}" Text="Type a name like Invoice-2026.pdf to see which rules match (uses your unsaved changes)." />
              <TextBlock Style="{StaticResource FieldLabel}" Text="Downloaded from (optional)" />
              <TextBox Text="{Binding TestSource, UpdateSourceTrigger=PropertyChanged}" />
              <TextBlock Margin="0,8,0,0" Text="{Binding TestResult}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </TabItem>
    </TabControl>

    <!-- Footer -->
    <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center">
        <Hyperlink Click="OpenDataFolder_Click">Open data folder</Hyperlink>
      </TextBlock>
      <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Click="Cancel_Click" Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right" Content="Save" Click="Save_Click" />
    </DockPanel>
  </Grid>
</Window>
